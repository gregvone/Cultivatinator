# Copy to .env to override Compose defaults. Never commit secrets.
APP_PORT=8085
DATA_DIR=/storage/tv/cultivatinator
MAINTENANCE_DIR=/run/cultivatinator-maintenance
# Secure default. Use .env.trusted-lan.example only for explicitly trusted clients.
CULTIVATINATOR_BACKUP_AUTH_MODE=password
CULTIVATINATOR_TRUSTED_NETWORKS=
# For local development with Compose instead: DATA_DIR=./data
