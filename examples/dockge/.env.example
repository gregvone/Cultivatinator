# Copy to /opt/stacks/cultivatinator/.env; keep a live .env out of Git.
# Host HTTP port. The container always listens on 8085.
APP_PORT=8085

# Absolute Debian HOST data root, containing database/, photos/, files/,
# settings/ and backups/. Reuse the existing directory; do not move its data.
# This may be customized independently of the fixed build.context in compose.yaml.
DATA_DIR=/storage/tv/cultivatinator

# Absolute HOST directory containing the installed helper socket and channel key.
# The supplied installer uses this standard path. Changing this variable alone
# does not relocate the systemd helper; it must match its actual runtime directory.
MAINTENANCE_DIR=/run/cultivatinator-maintenance

# Preferred configuration for your private LAN: every allowed client can
# administer backups and restores without a password. Use direct LAN access.
CULTIVATINATOR_BACKUP_AUTH_MODE=trusted_lan
# Comma-separated, explicit CIDRs. No implicit loopback or Docker-gateway trust.
CULTIVATINATOR_TRUSTED_NETWORKS=192.168.68.0/24

# Password-protected alternative: REPLACE the two active values above with these.
# Existing password credentials are retained; never put a passphrase in this file.
# CULTIVATINATOR_BACKUP_AUTH_MODE=password
# CULTIVATINATOR_TRUSTED_NETWORKS=
